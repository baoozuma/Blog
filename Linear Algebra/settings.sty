% Shared theorem counter.
\newcounter{theorem}[section]
\renewcommand{\thetheorem}{\thesection.\arabic{theorem}}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{example}[theorem]{Example}

\makeatletter
\def\@begintheorem#1#2{\trivlist
   \item[\hskip \labelsep{\sffamily\bfseries #1\ #2.}]}
\def\@opargbegintheorem#1#2#3{\trivlist
      \item[\hskip \labelsep{\sffamily\bfseries #1\ #2\ (#3).}]}
\makeatother

% Kept for compatibility with the existing source.
\definecolor{theoremblue}{RGB}{0,0,255}
\definecolor{definitionred}{RGB}{180,0,0}
\definecolor{claimyellow}{RGB}{190,145,0}
\definecolor{lemmaorange}{RGB}{230,115,0}
\definecolor{remarkgreen}{RGB}{0,128,0}
\definecolor{propositionviolet}{RGB}{110,70,170}
\definecolor{problemyellow}{RGB}{255,204,0}
\newsavebox{\envbodybox}
\newlength{\envwidth}
\newcommand{\envbegin}[4]{%
  \par\vspace{8pt}%
  \refstepcounter{theorem}%
  \if\relax\detokenize{#2}\relax
    \def\envtitle{#1\ \thetheorem.}%
  \else
    \def\envtitle{#1\ \thetheorem\ (#2).}%
  \fi
  \begingroup
  \setlength{\fboxrule}{1pt}%
  \setlength{\fboxsep}{0pt}%
  \setlength{\envwidth}{\dimexpr\linewidth-2\fboxrule\relax}%
  \begin{lrbox}{\envbodybox}%
  \begin{minipage}{\envwidth}%
  \colorbox{#3!20}{%
    \parbox{\dimexpr\envwidth-2\fboxsep\relax}{%
      \vspace{4pt}%
      \hspace{8pt}{\sffamily\bfseries\envtitle}%
      \vspace{4pt}%
    }%
  }%
  \par\nointerlineskip\noindent{\color{#3}\rule{\envwidth}{1pt}}%
  \par\noindent
  \hspace{10pt}%
  \begin{minipage}{\dimexpr\envwidth-20pt\relax}%
  \vspace{6pt}%
  #4%
}
\newcommand{\envend}[1]{%
  \par\vspace{8pt}%
  \end{minipage}%
  \end{minipage}%
  \end{lrbox}%
  \noindent\fcolorbox{#1}{white}{\usebox{\envbodybox}}%
  \endgroup
  \par\vspace{8pt}%
}
\newenvironment{theorem}[1][]{\envbegin{Theorem}{#1}{theoremblue}{}}{\envend{theoremblue}}
\newenvironment{definition}[1][]{\envbegin{Definition}{#1}{definitionred}{}}{\envend{definitionred}}
\newenvironment{claim}[1][]{%
  \par\vspace{8pt}%
  \refstepcounter{theorem}%
  \if\relax\detokenize{#1}\relax
    \def\claimtitle{Claim\ \thetheorem.}%
  \else
    \def\claimtitle{Claim\ \thetheorem\ (#1).}%
  \fi
  \noindent{\sffamily\bfseries\claimtitle}\quad
}{%
  \par\vspace{8pt}%
}
\newenvironment{lemma}[1][]{\envbegin{Lemma}{#1}{lemmaorange}{}}{\envend{lemmaorange}}
\newenvironment{remark}[1][]{\envbegin{Remark}{#1}{remarkgreen}{}}{\envend{remarkgreen}}
\newenvironment{proposition}[1][]{\envbegin{Proposition}{#1}{propositionviolet}{}}{\envend{propositionviolet}}
\newenvironment{boxedtheorem}[1][]{\begin{theorem}[#1]}{\end{theorem}}
\newenvironment{boxeddefinition}[1][]{\begin{definition}[#1]}{\end{definition}}
\newenvironment{boxedclaim}[1][]{\begin{claim}[#1]}{\end{claim}}
\newenvironment{boxedlemma}[1][]{\begin{lemma}[#1]}{\end{lemma}}
\newenvironment{boxedremark}[1][]{\begin{remark}[#1]}{\end{remark}}
\newenvironment{boxedproposition}[1][]{\begin{proposition}[#1]}{\end{proposition}}
% \newenvironment{problem}[1][]{\envbegin{Problem}{#1}{problemyellow}{}}{\envend{problemyellow}}
\newenvironment{boxedproblem}[1][]{\begin{problem}[#1]}{\end{problem}}
\newtheorem{problem}{Problem}[section]
% A lightweight proof environment because this MiKTeX install is missing amsthm.
\newenvironment{proof}[1][Proof]{%
  \par\medskip\noindent{\it #1.}\enspace
}{%
  \hfill\(\square\)\par\medskip
}
\newenvironment{solution}{\begin{proof}[Solution]}{\end{proof}}
\newenvironment{sol}{\begin{proof}[Solution]}{\end{proof}}

% Keywords line after the abstract.
\newcommand{\keywordname}{\textbf{\emph{Keywords}}}
\newcommand{\keywords}[1]{%
  \par\medskip\noindent\keywordname\enspace #1\par\medskip
}

\makeatletter
\renewcommand*\l@chapter{\@dottedtocline{0}{0em}{1.8em}}
\renewcommand*\l@section{\@dottedtocline{1}{1.5em}{2.3em}}
\renewcommand*\l@subsection{\@dottedtocline{2}{3.8em}{3.2em}}
\renewcommand*\l@subsubsection{\@dottedtocline{3}{7.0em}{4.1em}}
\makeatother

